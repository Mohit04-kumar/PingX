# -----------------------------------------------------------------------------
# PingX Production Backend Configuration Template
# -----------------------------------------------------------------------------

# Server Environment
PORT=4001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
# Example Local: postgresql://postgres:password@localhost:5432/pingx?schema=public
# Example Cloud (Supabase/Neon/Render): postgresql://user:pass@ep-cool-db.us-east-1.aws.neon.tech/pingx?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pingx?schema=public

# Security & Sessions
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
SESSION_SECRET=replace_with_a_secure_session_encryption_key

# Google OAuth 2.0 Credentials (Google Cloud Console)
# Redirect URI: http://localhost:4001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Transactional Email Provider (Resend / SendGrid)
# Free Tier: Resend provides 3,000 free emails/month at https://resend.com
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM="PingX Security <no-reply@pingx.app>"

# Transactional SMS / Phone OTP Provider (Twilio / MSG91 / 2Factor)
# For India DLT: 2Factor or MSG91 provides transactional SMS APIs
SMS_PROVIDER=mock_or_provider_name
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=PINGX

# AI Assistant Service (Google Gemini / OpenAI)
# Free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here

# Object Storage (Supabase Storage / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=supabase
STORAGE_ENDPOINT=
STORAGE_BUCKET=pingx-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
