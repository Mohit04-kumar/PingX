# -----------------------------------------------------------------------------
# PingX Production Frontend Environment Template
# -----------------------------------------------------------------------------

# Backend API Base URL (proxied automatically in development via vite.config.js)
VITE_API_BASE=http://localhost:4001

# Google OAuth Public Client ID (Client-side trigger)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Real-time WebSocket Gateway URL
VITE_SOCKET_URL=http://localhost:4001

# Firebase Phone Authentication Config (Free Tier up to 10k SMS/month)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
