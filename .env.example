# -----------------------------------------------------------------------------
# PingX Production Frontend Environment Template
# -----------------------------------------------------------------------------

# Backend API Base URL (proxied automatically in development via vite.config.js)
VITE_API_BASE=http://localhost:4001

# Google OAuth Public Client ID (Client-side trigger)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Real-time WebSocket Gateway URL
VITE_SOCKET_URL=http://localhost:4001
